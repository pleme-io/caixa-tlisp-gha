   :size 4870
   :body ";; caixa-tlisp-gha — GitHub Actions operations for tatara-lisp.\n;;\n;; Built for the one thing GitHub Actions makes genuinely awkward: qualifying a\n;; REUSABLE workflow change before it merges. A caller pins `uses: ...@master`,\n;; so a branch containing the change is never the thing that runs — the only way\n;; to exercise it is to repoint the caller at the branch, dispatch, and put the\n;; ref back. That sequence is easy to get half-done and leave a repo pointing at\n;; a branch, which is why it belongs in a library with a restore primitive\n;; rather than in each script that needs it.\n\n;; ── run state ───────────────────────────────────────────────────────────\n\n(define (gha:latest-run-id repo workflow)\n  (let ((r (exec-capture \"gh\" \"run\" \"list\" \"-R\" repo \"--workflow\" workflow\n                          \"-L\" \"1\" \"--json\" \"databaseId\" \"-q\" \".[0].databaseId\")))\n    (cond ((= (status-of r) 0) (string-trim (stdout-of r)))\n          (else \"\"))))\n\n(define (gha:run-status repo run-id)\n  (let ((r (exec-capture \"gh\" \"run\" \"view\" run-id \"-R\" repo\n                          \"--json\" \"status\" \"-q\" \".status\")))\n    (cond ((= (status-of r) 0) (string-trim (stdout-of r)))\n          (else \"\"))))\n\n(define (gha:run-conclusion repo run-id)\n  (let ((r (exec-capture \"gh\" \"run\" \"view\" run-id \"-R\" repo\n                          \"--json\" \"conclusion\" \"-q\" \".conclusion\")))\n    (cond ((= (status-of r) 0) (string-trim (stdout-of r)))\n          (else \"\"))))\n\n(define (gha:run-url repo run-id)\n  (string-append \"https://github.com/\" repo \"/actions/runs/\" run-id))\n\n;; Poll to a TERMINAL state, never a fixed sleep. A guessed delay is either a\n;; wasted wait or a false read; self-hosted spot runners here routinely take\n;; minutes of cold start before a job even begins.\n(define (gha:wait-run repo run-id max-polls interval-sec)\n  (cond\n    ((<= max-polls 0) \"timeout\")\n    (else\n      (let ((st (gha:run-status repo run-id)))\n        (cond\n          ((equal? st \"completed\") (gha:run-conclusion repo run-id))\n          ((equal? st \"\") \"unknown\")\n          (else\n            (begin\n              (sleep interval-sec)\n              (gha:wait-run repo run-id (- max-polls 1) interval-sec))))))))\n\n(define (gha:job-lines repo run-id)\n  (let ((r (exec-capture \"sh\" \"-c\"\n             (string-append \"gh run view \" run-id \" -R \" repo\n                            \" --json jobs -q '.jobs[] | \\\"  \\\\(.conclusion // .status)  \\\\(.name)\\\"'\"))))\n    (stdout-of r)))\n\n;; ── dispatch ────────────────────────────────────────────────────────────\n\n;; inputs is a flat list of \"key=value\" strings. Each becomes its own -f\n;; argument — never a single interpolated string, so a value containing a\n;; space or a quote cannot change the shape of the command.\n(define (gha:dispatch repo workflow ref inputs)\n  (let ((argv (append (list \"gh\" \"workflow\" \"run\" workflow \"-R\" repo \"--ref\" ref)\n                      (gha:input-args inputs))))\n    (apply exec-capture argv)))\n\n(define (gha:input-args inputs)\n  (cond ((null? inputs) (list))\n        (else (append (list \"-f\" (car inputs)) (gha:input-args (cdr inputs))))))\n\n;; ── reusable-workflow ref repointing ────────────────────────────────────\n;;\n;; A caller references a reusable workflow as\n;;   uses: owner/repo/.github/workflows/name.yaml@ref\n;; Qualifying a change to that workflow means temporarily moving @ref onto the\n;; branch under test.\n\n(define (gha:uses-ref-of file target)\n  (let ((r (exec-capture \"sh\" \"-c\"\n             (string-append \"grep -oE '\" target \"@[A-Za-z0-9._/-]+' \" file\n                            \" | head -1 | sed 's|.*@||'\"))))\n    (string-trim (stdout-of r))))\n\n(define (gha:uses-repoint file target from-ref to-ref)\n  (let ((r (exec-capture \"sh\" \"-c\"\n             (string-append \"grep -q '\" target \"@\" from-ref \"' \" file\n                            \" && sed -i.caixa-bak 's|\" target \"@\" from-ref\n                            \"|\" target \"@\" to-ref \"|g' \" file))))\n    (= (status-of r) 0)))\n\n;; Restore is deliberately its own primitive, not a flag on repoint. A\n;; half-finished qualification that leaves a caller pointed at a feature branch\n;; is worse than never having run it, so the undo has to be callable on its own\n;; — including from a later session that did not do the repointing.\n(define (gha:uses-restore file)\n  (let ((r (exec-capture \"sh\" \"-c\"\n             (string-append \"test -f \" file \".caixa-bak && mv \" file \".caixa-bak \" file))))\n    (= (status-of r) 0)))\n\n(define (gha:uses-repointed? file target expected-ref)\n  (not (equal? (gha:uses-ref-of file target) expected-ref)))\n"} {:path "README.md"
